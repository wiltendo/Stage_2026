<%- include('fragments/head.ejs')%>
<link rel="stylesheet" href="/css/inscription_connexion.css">
<script src="afficherMDP.js"></script>
<script src="https://www.google.com/recaptcha/api.js" async defer></script>

</head>
<body>
    <div class="page">
<%- include('fragments/navigation.ejs')%>

<main class="main_center">
<div class="container" id="container">
   <div class="form_container">
       <div class="form_connexion">
           <form action="/Auth" method="POST">
               <h1>Connexion</h1>
                <% if(typeof(Erreur)!='undefined') {%>
                    <h4 class="Erreur"><%=Erreur %></h4>
                    <br>
                    <br>
                <%}%>
                <% if(typeof(Reussi)!='undefined') {%>
                    <h4 class="Reussi"><%=Reussi %></h4>
                    <br>
                    <br>
                <%}%>


               <div class="info-bulle">
                   <label for="Mail"><strong>Mail</strong>
                       <input class="inputForm" type="email" name="Mail" id="Mail" required>
                   </label>
               </div>

               <br>

               <div class="champs-password">
                   <div class="info-bulle">
                       <label for='password'><strong>Mot de passe </strong>
                           <input id='password' type='password' name ='password' class='inputForm' required>
                        </label>
                   </div>

                   <div class="password-show" onclick="showPassword(this)" onkeydown="showPassword(this)" tabindex="0">
                       <img src="img/visible.png" alt="afficher le mot de passe">
                   </div>
                   <div class="password-hide" onclick="hidePassword(this)" onkeydown="hidePassword(this)" tabindex="0">
                       <img src="img/hidden.png" alt="cacher le mot de passe">
                   </div>
               </div>

                <ul id="Valid_mdp" style="display: none;">
                   <li id="length_mdp" class="invalid">doit contenir au moins 8 caractères</li>
                   <li id="majuscule_mdp" class="invalid">doit contenir au moins 1 majuscule</li>
                   <li id="minuscule_mdp" class="invalid">doit contenir au moins 1 minuscule</li>
                   <li id="chiffre_mdp" class="invalid">doit contenir au moins 1 chiffre</li>
                   <li id="special_mdp" class="invalid">doit contenir au moins 1 caractère spécial (%?*#!_-)</li>
                </ul>

                <div
                class="g-recaptcha"
                data-sitekey="6LcT6ggtAAAAADR1p-JY_kk2ZfzCooNEn4-WBraM"
                ></div>
               
                <br>
                <div style="display: flex;">
                    <input class="button" type="submit" value="Connexion" id="submit" style="height: 70px;">
                    <a class="button" style="margin-left:10px;height: 70px;display: flex;align-items: center;" href="/Inscription">Inscription</a>
                </div>
                <input type="hidden" value="<%= csrfToken%>" name="_csrf">
            </form>

            <button class="button" onclick="document.getElementById('MDPForgottent').style.display = 'block'">Mot de passe oublié</button>
            
            <form id="MDPForgottent" style="display: none;" action="/MdpForgottent" method="POST">

                <h1>Mot de passe oublié</h1>

                <div class="info-bulle">
                   <label for="Mail_recup"><strong>Mail</strong>
                       <input class="inputForm" type="email" name="Mail_recup" id="Mail_recup" required>
                   </label>
               </div>

               <div
                class="g-recaptcha"
                data-sitekey="6LcT6ggtAAAAADR1p-JY_kk2ZfzCooNEn4-WBraM"
                ></div>

               <input class="button" type="submit" value="Envoie Mail" id="submit" style="height: 70px;">

               <input type="hidden" value="<%= csrfToken%>" name="_csrf">
            </form>
       </div>
   </div>
</div>

<script src="/valid_password.js"></script>
</main>
<%- include('fragments/foot.ejs')%>

